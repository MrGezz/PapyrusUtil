  <!--
    Where the dependencies live. Every value can be overridden on the command line
    (msbuild PapyrusUtil.vcxproj -p:SKSE64Root=... -p:VcpkgInstalled=...). Defaults assume the
    IcZ Skyrim workspace layout: this repo in "Project Improvement\", ianpatt's skse64 and common
    checkouts at the workspace root, the SKSE libraries staged by "Runtime 1.7.99", and Boost from
    "vcpkg install - -triplet x64-windows-static" run next to this file (see vcpkg.json).
  -->
  <PropertyGroup Label="Dependencies">
    <SKSE64Root Condition="'$(SKSE64Root)'==''">$(MSBuildProjectDirectory)\..\..\skse64\</SKSE64Root>
    <CommonRoot Condition="'$(CommonRoot)'==''">$(MSBuildProjectDirectory)\..\..\common\</CommonRoot>
    <SKSELibDir Condition="'$(SKSELibDir)'==''">$(MSBuildProjectDirectory)\..\Runtime 1.7.99\SKSE64 2.3.0\lib\</SKSELibDir>
    <SKSEStaticLib Condition="'$(SKSEStaticLib)'==''">skse64_1_7_99_static.lib</SKSEStaticLib>
    <VcpkgInstalled Condition="'$(VcpkgInstalled)'==''">$(MSBuildProjectDirectory)\vcpkg_installed\x64-windows-static\</VcpkgInstalled>
    <BoostLibs Condition="'$(BoostLibs)'==''">boost_filesystem-vc145-mt-x64-1_91.lib;boost_atomic-vc145-mt-x64-1_91.lib;boost_container-vc145-mt-x64-1_91.lib;boost_random-vc145-mt-x64-1_91.lib</BoostLibs>
    <!-- Must match the skse64 objects the static library was built from (RUNTIME_VERSION_1_7_99). -->
    <SKSERuntimeVersion Condition="'$(SKSERuntimeVersion)'==''">0x1070630</SKSERuntimeVersion>
  </PropertyGroup>
