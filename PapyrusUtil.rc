#include <windows.h>
#include "resource.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PAPYRUSUTIL_FILE_VERSION
 PRODUCTVERSION PAPYRUSUTIL_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PapyrusUtil SE - SKSE64 plugin"
            VALUE "FileVersion", PAPYRUSUTIL_FILE_VERSION_STR
            VALUE "InternalName", "PapyrusUtil"
            VALUE "LegalCopyright", "Ashal (exiledviper); 1.7.99 build IcZ"
            VALUE "OriginalFilename", "PapyrusUtil.dll"
            VALUE "ProductName", "PapyrusUtil SE"
            VALUE "ProductVersion", PAPYRUSUTIL_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
